# ============================================================================
# Agent Storefront — deployment configuration
# ============================================================================
# Settlement mode. 'simulate' (DEFAULT) settles in-process against the delegated
# token — NO Razorpay call, NO payment link, NO quota. A public deploy ships with
# NO Razorpay keys and stays on simulate. Set 'razorpay' only for a real capture.
ACG_SETTLEMENT_MODE=simulate

# Production hardening (set on the deployed backend):
ACG_ENV=prod                          # hides /docs + /openapi.json
ACG_ALLOWED_ORIGINS=https://your-app.vercel.app   # CORS allow-list (comma-separated)
ACG_CONSOLE_PASSWORD=change-me        # gates merchant+rail console; buyer chat stays open

# Frontend -> backend base (set on Vercel): ACG_API_BASE=https://your-backend.onrender.com
# ----------------------------------------------------------------------------

# Supabase Postgres. App uses the POOLER uri (6543); Alembic uses the DIRECT uri (5432).
DATABASE_URL=
DIRECT_URL=

# Upstash Redis (nonce store + Gemini rate-limit counter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini (buyer stand-in agent + off-money-path insight text ONLY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay TEST MODE ONLY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mandate key registry ids (see data/generate_keys.py)
MANDATE_USER_KID=user-test-1
MANDATE_AGENT_KID=agent-test-1
MANDATE_MERCHANT_KID=merchant-test-1

# Merchant identity used in mandate scope checks
ACG_MERCHANT_ID=merchant://acg-sports

# Razorpay webhook secret (Test mode) — set when you configure the webhook in the
# dashboard (see WEBHOOK_SETUP.md). Separate from the live-mode secret.
RAZORPAY_WEBHOOK_SECRET=

# Settlement capture mode: 'link' (default, no S2S needed) or 's2s' (only if your
# account has S2S enabled).
ACG_CAPTURE_MODE=link

# Dummy customer contact sent with each Payment Link (test mode only; never a real
# buyer's number). Razorpay rejects contacts with recurring/repeated digits (e.g.
# +919999999999 fails with "Recurring digits in customer contact are disallowed") —
# keep this a non-repeating, valid-format Indian mobile number.
ACG_TEST_CONTACT=+919876543210
